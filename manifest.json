{
  "schemaVersion": 1,
  "id": "io.mcmurray.freenet-explorer",
  "name": "Freenet Explorer",
  "version": "0.1.0",
  "author": "Ian McMurray",
  "license": "MIT",
  "description": "Bar status and controls for the local Freenet Explorer.",
  "kinds": ["service", "bar-widget"],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Freenet Explorer",
    "description": "Node and explorer status. Click to start, stop, or open the UI.",
    "category": "Network",
    "aliases": ["freenet", "explorer"],
    "allowMultiple": false,
    "defaultSection": "right"
  },
  "keywords": ["freenet", "explorer"]
}
