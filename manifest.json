{
  "schemaVersion": 1,
  "id": "io.mcmurray.freenet-explorer",
  "name": "Freenet",
  "version": "0.1.0",
  "author": "Ian McMurray",
  "license": "MIT",
  "description": "Bar entry point for the local Freenet peer, its apps, and Freenet Explorer.",
  "kinds": ["service", "bar-widget"],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Freenet",
    "description": "Local peer, its apps, and Freenet Explorer. Click to open.",
    "category": "Network",
    "aliases": ["freenet", "explorer", "aegis"],
    "allowMultiple": false,
    "defaultSection": "right"
  },
  "keywords": ["freenet", "explorer", "aegis", "peer"]
}
